# ---------------------------------------------------------------------------
# Supabase — from your project's dashboard: Settings → API
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored and must never be committed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. Used by scripts/import.ts.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# One-time spreadsheet import (scripts/import.ts)
# Listener 1 (spreadsheet columns A/B) = you. Listener 2 (columns H/I) = a
# friend placeholder you can rename or re-invite later. Both accounts are
# created and friended automatically.
# ---------------------------------------------------------------------------
IMPORT_OWNER_EMAIL=you@example.com
IMPORT_OWNER_NAME=Bazcario
IMPORT_FRIEND_EMAIL=friend@example.com
IMPORT_FRIEND_NAME=Listener Two
# Initial password set on the seeded accounts (change after first login).
IMPORT_DEFAULT_PASSWORD=ChangeMe-1234
# Absolute or relative path to the source spreadsheet.
IMPORT_XLSX_PATH=../Downloads/Bazcario's Album Archive.xlsx
